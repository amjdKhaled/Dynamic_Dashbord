@using System.Text.Json
@{
    ViewData["Title"] = "لوحة المعلومات الديناميكية";
    var scope = (string?)ViewBag.StorageScope ?? string.Empty;
}
@section Styles {
    <link rel="stylesheet" href="~/css/dynamic-dashboard.css" asp-append-version="true" />
}
<div class="dd-page dd-is-loading" id="dynamicDashboard" dir="rtl" data-scope="@scope" data-repository="@ViewBag.RepositoryId" data-archive-url="@Url.Action("OpenDashboardSelection", "Archive")">
    @Html.AntiForgeryToken()
    <div id="dd-loading" class="dd-loading" role="status" aria-label="تحميل بيانات Laserfiche"><span></span></div>
    <div class="dd-content" inert>
    <header class="dd-header">
        <div class="dd-headline">
            <h1>لوحة المعلومات <span>الديناميكية</span></h1>
        </div>
        <div class="dd-head-actions">
            <button type="button" class="dd-btn" id="dd-repository">تبديل المستودع · @ViewBag.RepositoryId</button>
            <button type="button" class="dd-btn" id="dd-refresh">⟳ تحديث البيانات</button>
            <button type="button" class="dd-btn" id="dd-customize" aria-pressed="false">⚙ تخصيص اللوحة</button>
            <button type="button" class="dd-btn dd-btn-primary dd-hidden" id="dd-add">＋ إضافة شارت</button>
        </div>
    </header>
    <div class="dd-layout">
        <section class="dd-workspace" aria-label="محتوى اللوحة">
            <div class="dd-layout-bar" aria-label="حفظ اللوحة">
                <strong>لوحتي المحفوظة</strong>
                <div class="dd-save-actions">
                    <span id="dd-layout-status" role="status"></span>
                    <button type="button" class="dd-btn dd-btn-primary" id="dd-save-layout" disabled>حفظ ترتيب اللوحة</button>
                </div>
            </div>
            <p id="dd-warning" class="dd-warning dd-hidden" role="alert"></p>
            <div class="dd-grid" id="dd-grid"></div>
            <div id="dd-empty" class="dd-empty dd-hidden">لا توجد كروت ظاهرة.</div>
        </section>
    </div>
    </div>
    <dialog id="dd-repository-dialog" class="dd-repository-dialog">
        <form method="post" action="@Url.Action("SwitchRepository", "Login")">
            @Html.AntiForgeryToken()
            <label class="dd-label" for="dd-repository-list">مستودع Laserfiche</label>
            <select class="dd-control" id="dd-repository-list" name="repository" required></select>
            <div id="dd-repository-password-wrap" hidden>
                <label class="dd-label" for="dd-repository-password">كلمة مرور حسابك الحالي</label>
                <input class="dd-control" id="dd-repository-password" type="password" name="password" autocomplete="current-password" />
            </div>
            <p id="dd-repository-message" role="status"></p>
            <div class="dd-editor-actions">
                <button type="button" id="dd-repository-cancel" class="dd-btn">إلغاء</button>
                <button type="submit" id="dd-repository-submit" class="dd-btn dd-btn-primary" disabled>تبديل المستودع</button>
            </div>
        </form>
    </dialog>
    <div id="dd-editoroverlay" class="dd-overlay dd-hidden">
        <section class="dd-editor" role="dialog" aria-modal="true" aria-labelledby="dd-editor-title">
            <div class="dd-editor-head">
                <h2 id="dd-editor-title">إعدادات الشارت</h2>
                <button type="button" id="dd-closeeditor" class="dd-icon-btn" aria-label="إغلاق">✕</button>
            </div>
            <label class="dd-label" for="dd-title">العنوان</label>
            <input class="dd-control" id="dd-title" maxlength="90" placeholder="مثال: المعاملات حسب الإدارة" />
            <label class="dd-label" for="dd-type">نوع العرض</label>
            <select class="dd-control" id="dd-type">
                <option value="bar">أعمدة عمودية</option>
                <option value="horizontal">أعمدة أفقية</option>
                <option value="line">خطي</option>
                <option value="doughnut">دائري مجوف</option>
                <option value="pie">دائري</option>
                <option value="table">جدول التجميع</option>
                <option value="documents">جدول الوثائق</option>
                <option value="recent-created">جدول المستندات المنشأة حديثًا</option>
                <option value="recent-modified">جدول نشاط المستندات الأخير</option>
                <option value="kpi">بطاقة رقم</option>
            </select>
            <p id="dd-display-limit" class="dd-warning dd-hidden" role="status"></p>
            <div id="dd-axis-options">
            <label class="dd-label" for="dd-dimension">البيانات / المحور التصنيفي</label>
            <select class="dd-control" id="dd-dimension"></select>
            <div id="dd-field-options" class="dd-hidden">
                <label class="dd-label" for="dd-field">الحقل</label>
                <select class="dd-control" id="dd-field"></select>
            </div>
            </div>
            <div id="dd-modified-range" class="dd-dates dd-hidden">
                <label class="dd-label">من تاريخ <input type="date" id="dd-modified-from" class="dd-control" /></label>
                <label class="dd-label">إلى تاريخ <input type="date" id="dd-modified-to" class="dd-control" /></label>
            </div>
            <div id="dd-page-count" class="dd-hidden">
                <label class="dd-label" for="dd-pages">عدد الصفحات (مطابقة الرقم)</label>
                <input type="text" inputmode="decimal" maxlength="24" id="dd-pages" class="dd-control" />
            </div>
            <div id="dd-category-options">
            <label class="dd-label" for="dd-value-search">القيم الموجودة في الوثائق (اختياري)</label>
            <div class="dd-values-actions">
                <input type="search" id="dd-value-search" class="dd-control" placeholder="البحث عن قيمة..." autocomplete="off" />
                <button type="button" id="dd-clear-values" class="dd-btn">عرض جميع القيم</button>
            </div>
            <div id="dd-value-list" class="dd-value-list" aria-live="polite"></div>
            </div>
            <p id="dd-filter-error" class="dd-warning dd-hidden" role="alert"></p>
            <div class="dd-editor-actions">
                <button type="button" id="dd-cancel" class="dd-btn">إلغاء</button>
                <button type="button" id="dd-save" class="dd-btn dd-btn-primary">حفظ الشارت</button>
            </div>
        </section>
    </div>

</div>
@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dynamic-dashboard.js" asp-append-version="true"></script>
}
