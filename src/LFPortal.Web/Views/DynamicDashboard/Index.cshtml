@model DashboardViewModel
@{
    ViewData["EmbedDashboardOverview"] = true;
    var arabic = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string ar, string en) => arabic ? ar : en;
    ViewData["Title"] = T("لوحة المعلومات الديناميكية", "Dynamic Dashboard");
    var scope = (string?)ViewBag.StorageScope ?? string.Empty;
}
@section DashboardNavigation {
    <div class="dd-nav-actions" role="group" aria-label="@T("إجراءات اللوحة", "Dashboard actions")">
        <button type="button" id="dd-refresh">@T("تحديث اللوحة", "Refresh dashboard")</button>
        <button type="button" id="dd-new-board" disabled>@T("إنشاء لوحة جديدة", "Create dashboard")</button>
        <button type="button" id="dd-customize" aria-pressed="false">@T("تخصيص اللوحة", "Customize dashboard")</button>
    </div>
}
@section Styles {
    <partial name="~/Views/Dashboard/_OverviewStyles.cshtml" />
    <link rel="stylesheet" href="~/css/dynamic-dashboard.css" asp-append-version="true" />
}
<div class="dd-page dd-is-loading" id="dynamicDashboard" dir="@(arabic ? "rtl" : "ltr")" data-password-switch="@ViewBag.PasswordSwitch" data-language="@(arabic ? "ar" : "en")" data-scope="@scope" data-repository="@ViewBag.RepositoryId" data-archive-url="@Url.Action("OpenDashboardSelection", "Archive")">
    @Html.AntiForgeryToken()
    <div id="dd-loading" class="dd-loading" role="status" aria-label="@T("تحميل بيانات Laserfiche", "Loading Laserfiche data")"><span></span></div>
    <div class="dd-content" inert>
    <header class="dd-header">
        <div class="dd-headline">
            <h1>@T("لوحة المعلومات", "Dynamic") <span>@T("الديناميكية", "Dashboard")</span></h1>
        </div>
        <div class="dd-head-actions">
            <div class="dd-board-picker">
                <select class="dd-control" id="dd-board-list" aria-label="@T("اختيار اللوحة", "Select dashboard")" disabled>
                    <option value="default">@T("اللوحة الرئيسية", "Main dashboard")</option>
                </select>
                <button type="button" class="dd-btn" id="dd-rename-board" disabled>@T("تغيير الاسم", "Rename")</button>
                <button type="button" class="dd-btn dd-delete-board dd-toolbar-hidden" id="dd-delete-board" disabled>@T("حذف اللوحة", "Delete dashboard")</button>
            </div>
            <div class="dd-head-group">
                <button type="button" class="dd-btn dd-btn-primary dd-toolbar-hidden" id="dd-add">@T("＋ إضافة جدول", "＋ Add table")</button>
                <button type="button" class="dd-btn dd-btn-primary dd-toolbar-hidden" id="dd-save-layout" disabled>@T("حفظ اللوحة", "Save dashboard")</button>
            </div>
            <div class="dd-head-group">
                <button type="button" class="dd-btn" id="dd-repository">@T("تبديل المستودع", "Switch repository") · @ViewBag.RepositoryId</button>
            </div>
        </div>
        <span id="dd-layout-status" role="status"></span>
    </header>
    <div class="dd-layout">
        <section class="dd-workspace" aria-label="@T("محتوى اللوحة", "Dashboard content")">
            <p id="dd-warning" class="dd-warning dd-hidden" role="alert"></p>
            <section id="dd-main-overview" aria-label="@T("إحصائيات اللوحة الرئيسية", "Main dashboard statistics")">
                <partial name="~/Views/Dashboard/_Overview.cshtml" model="Model" />
            </section>
            <div class="dd-grid" id="dd-grid"></div>
            <div id="dd-empty" class="dd-empty dd-hidden">@T("لا توجد كروت ظاهرة.", "No visible cards.")</div>
        </section>
    </div>
    </div>
    <dialog id="dd-board-dialog" class="dd-repository-dialog" aria-labelledby="dd-board-dialog-title">
        <form>
            <strong id="dd-board-dialog-title"></strong>
            <label class="dd-label" for="dd-board-name">@T("اسم اللوحة", "Dashboard name")</label>
            <input class="dd-control" id="dd-board-name" maxlength="80" required />
            <p id="dd-board-error" role="alert"></p>
            <div class="dd-editor-actions">
                <button type="button" class="dd-btn" id="dd-board-cancel">@T("إلغاء", "Cancel")</button>
                <button type="submit" class="dd-btn dd-btn-primary">@T("متابعة", "Continue")</button>
            </div>
        </form>
    </dialog>
    <dialog id="dd-repository-dialog" class="dd-repository-dialog">
        <form method="post" action="@Url.Action("SwitchRepository", "Login")">
            @Html.AntiForgeryToken()
            <label class="dd-label" for="dd-repository-list">@T("مستودع Laserfiche", "Laserfiche repository")</label>
            <select class="dd-control" id="dd-repository-list" name="repository" required></select>
            <div id="dd-repository-manual-wrap" hidden>
                <label class="dd-label" for="dd-repository-manual">@T("معرّف المستودع", "Repository ID")</label>
                <input class="dd-control" id="dd-repository-manual" name="repository" maxlength="200" disabled />
            </div>
            <div id="dd-repository-password-wrap" hidden>
                <label class="dd-label" for="dd-repository-password">@T("كلمة مرور حسابك الحالي", "Current account password")</label>
                <input class="dd-control" id="dd-repository-password" type="password" name="password" autocomplete="current-password" />
            </div>
            <p id="dd-repository-message" role="status"></p>
            <div class="dd-editor-actions">
                <button type="button" id="dd-repository-cancel" class="dd-btn">@T("إلغاء", "Cancel")</button>
                <button type="submit" id="dd-repository-submit" class="dd-btn dd-btn-primary" disabled>@T("تبديل المستودع", "Switch repository")</button>
            </div>
        </form>
    </dialog>
    <div id="dd-editoroverlay" class="dd-overlay dd-hidden">
        <section class="dd-editor" role="dialog" aria-modal="true" aria-labelledby="dd-editor-title">
            <div class="dd-editor-head">
                <h2 id="dd-editor-title">@T("إعدادات الجدول", "Table settings")</h2>
                <button type="button" id="dd-closeeditor" class="dd-icon-btn" title="@T("إغلاق", "Close")" aria-label="@T("إغلاق", "Close")">✕</button>
            </div>
            <label class="dd-label" for="dd-title">@T("الاسم", "Name")</label>
            <input class="dd-control" id="dd-title" maxlength="90" placeholder="@T("مثال: المعاملات حسب الإدارة", "Example: Transactions by department")" />
            <label class="dd-label" for="dd-type">@T("نوع العرض", "Display type")</label>
            <select class="dd-control" id="dd-type">
                <option value="overview" id="dd-overview-type" hidden disabled>@T("العرض الأصلي للبطاقة", "Original widget view")</option>
                <option value="bar">@T("أعمدة عمودية", "Vertical bars")</option>
                <option value="horizontal">@T("أعمدة أفقية", "Horizontal bars")</option>
                <option value="line">@T("خطي", "Line chart")</option>
                <option value="doughnut">@T("دائري مجوف", "Doughnut chart")</option>
                <option value="pie">@T("دائري", "Pie chart")</option>
                <option value="table">@T("جدول الإحصاءات", "Statistics table")</option>
                <option value="documents">@T("قائمة المستندات", "Document list")</option>
                <option value="recent-created">@T("جدول المستندات المنشأة", "Created documents table")</option>
                <option value="recent-modified">@T("جدول نشاط المستندات", "Document activity table")</option>
                <option value="kpi">@T("بطاقة", "Card")</option>
            </select>
            <div id="dd-card-color" class="dd-hidden">
            <label class="dd-label" for="dd-card-style">@T("لون البطاقة", "Card color")</label>
            <select class="dd-control" id="dd-card-style">
                <option value="standard">@T("عادي - أبيض", "Standard - white")</option>
                <option value="accent">@T("مميز - كحلي بحد ذهبي", "Featured - navy with gold trim")</option>
            </select>
            </div>
            <p id="dd-display-limit" class="dd-warning dd-hidden" role="status"></p>
            <div id="dd-axis-options">
            <label class="dd-label" for="dd-dimension">@T("البيانات / المحور التصنيفي", "Data / category axis")</label>
            <select class="dd-control" id="dd-dimension"></select>
            <div id="dd-field-options" class="dd-hidden">
                <label class="dd-label" for="dd-field">@T("الحقل", "Field")</label>
                <select class="dd-control" id="dd-field"></select>
            </div>
            </div>
            <div id="dd-modified-range" class="dd-dates dd-hidden">
                <label class="dd-label">@T("من تاريخ", "From date") <input type="date" id="dd-modified-from" class="dd-control" /></label>
                <label class="dd-label">@T("إلى تاريخ", "To date") <input type="date" id="dd-modified-to" class="dd-control" /></label>
            </div>
            <div id="dd-page-count" class="dd-hidden">
                <label class="dd-label" for="dd-pages">@T("عدد الصفحات (مطابقة الرقم)", "Page count (exact match)")</label>
                <input type="text" inputmode="decimal" maxlength="24" id="dd-pages" class="dd-control" />
            </div>
            <div id="dd-category-options">
            <label class="dd-label" for="dd-value-search">@T("القيم الموجودة في الوثائق (اختياري)", "Document values (optional)")</label>
            <div class="dd-values-actions">
                <input type="search" id="dd-value-search" class="dd-control" placeholder="@T("البحث عن قيمة...", "Search for a value...")" autocomplete="off" />
                <button type="button" id="dd-clear-values" class="dd-btn">@T("اختيار الكل", "Select all")</button>
            </div>
            <div id="dd-value-list" class="dd-value-list" aria-live="polite"></div>
            </div>
            <div id="dd-chart-colors" class="dd-hidden">
                <label class="dd-label" for="dd-color-search">@T("ألوان الرسم البياني", "Chart colors")</label>
                <input type="search" class="dd-control" id="dd-color-search" placeholder="@T("البحث عن قيمة…", "Search values…")" />
                <div id="dd-color-list" class="dd-value-list"></div>
            </div>
            <p id="dd-filter-error" class="dd-warning dd-hidden" role="alert"></p>
            <div class="dd-editor-actions">
                <button type="button" id="dd-cancel" class="dd-btn">@T("إلغاء", "Cancel")</button>
                <button type="button" id="dd-save" class="dd-btn dd-btn-primary dd-hidden">@T("حفظ الجدول", "Save table")</button>
            </div>
        </section>
    </div>

</div>
@section Scripts {
    <script src="~/js/dashboard-round-scroll.js" asp-append-version="true"></script>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dynamic-dashboard.js" asp-append-version="true"></script>
}
