<style>
    @@font-face {
    font-family: "IBM Plex Sans Arabic";
    src: url("/fonts/IBMPlexSansArabic-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
}

@@font-face {
    font-family: "IBM Plex Sans Arabic";
    src: url("/fonts/IBMPlexSansArabic-Medium.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
}

@@font-face {
    font-family: "IBM Plex Sans Arabic";
    src: url("/fonts/IBMPlexSansArabic-SemiBold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
}

@@font-face {
    font-family: "IBM Plex Sans Arabic";
    src: url("/fonts/IBMPlexSansArabic-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
}

.ibm-plex-sans-arabic-thin {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 100;
  font-style: normal;
}

.ibm-plex-sans-arabic-extralight {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 200;
  font-style: normal;
}

.ibm-plex-sans-arabic-light {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 300;
  font-style: normal;
}

.ibm-plex-sans-arabic-regular {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 400;
  font-style: normal;
}

.ibm-plex-sans-arabic-medium {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 500;
  font-style: normal;
}

.ibm-plex-sans-arabic-semibold {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 600;
  font-style: normal;
}

.ibm-plex-sans-arabic-bold {
  font-family: "IBM Plex Sans Arabic", sans-serif;
  font-weight: 700;
  font-style: normal;
}


.dashboard-overview :is(button,input,select,textarea) {
    font-family: inherit;
}
body:has(.dashboard-overview-standalone) { background: #F7F8FD !important; font-family: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif; }
/* Share the regular Dashboard's content width with the dynamic page. */
main:has(> :is(.dashboard-overview-standalone, .dd-page)) {
    width: 100%;
    max-width: 1440px !important;
    padding: 18px 22px !important;
}
@@media (max-width: 640px) {
    main:has(> :is(.dashboard-overview-standalone, .dd-page)) {
        padding-inline: 14px !important;
    }
}
body:has(.dashboard-overview-standalone) footer.site-footer { background: #F7F8FD !important; }

:root {
    --d-bg:      #F7F8FD;
    --d-surface: #FFFFFF;
    --d-surf2:   #0878e8;
    --d-border:  #e1e1e1;
    --d-text:    #000000;
    --d-secondary:#94A3B8;
    --d-muted:   #000000;
    --d-accent:  #3B82F6;
    --d-teal:    #14B8A6;
    --d-violet:  #8B5CF6;
    --d-green:   #22C55E;
    --d-orange:  #F97316;
    --d-red:     #EF4444;
}

.d-title   { color: var(--d-text); font-size: 1.8rem; font-weight: bold;}
.d-sub     { color: var(--d-muted); font-size: 0.78rem; margin-top: 2px; }
.d-card    { background: var(--d-surface); border: none var(--d-border); border-radius: 12px; padding: 18px; box-shadow: 1px 1px 10px 1px rgba(0, 0, 0, 0.1);}
.d-grid-5  { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; }
.d-grid-2  { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; }
.d-grid-1  { display: grid; gap: 18px; }
.d-kpi-icon{ width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.d-kpi-val { font-size: 1.8rem; font-weight: 700; color: var(--d-text); }
.d-kpi-lbl { color: var(--d-muted); font-size: 0.75rem; margin-top:2px; }
.d-section-bar { width:4px;height:18px;border-radius:4px;background:var(--d-accent);display:inline-block;margin-inline:8px;flex-shrink:0; }
.d-card-title  { color:var(--d-text);font-size:.83rem;font-weight:600; display:flex;align-items:center; }
.d-card-sub    { color:var(--d-muted);font-size:.72rem; }
.d-badge       { display:inline-flex;align-items:center;gap:4px;font-size:.68rem;padding:2px 8px;border-radius:999px;font-weight:500; }
.d-badge-teal  { background:rgba(20,184,166,.12);color:#2dd4bf;border:1px solid rgba(20,184,166,.25); }
.d-badge-blue  { background:rgba(59,130,246,.12);color:#60a5fa;border:1px solid rgba(59,130,246,.25); }
.d-badge-green { background:rgba(34,197,94,.12);color:#4ade80;border:1px solid rgba(34,197,94,.25); }
.d-badge-red   { background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25); }
.d-badge-orange{ background:rgba(249,115,22,.12);color:#fb923c;border:1px solid rgba(249,115,22,.25); }
.d-badge-violet{ background:rgba(139,92,246,.12);color:#a78bfa;border:1px solid rgba(139,92,246,.25); }
.d-badge-indigo{ background:rgba(99,102,241,.12);color:#818cf8;border:1px solid rgba(99,102,241,.25); }
.d-tbl { width:100%;border-collapse:collapse;font-size:.77rem; }
.d-tbl th { text-align:start;padding:7px 11px;font-weight:600;color:var(--d-muted);background:rgba(255,255,255,.04);border-bottom:1px solid var(--d-border); }
.d-tbl td { padding:7px 11px;color:var(--d-text);border-bottom:1px solid #e1e1e1; }
.d-tbl tr:hover td { background:rgba(255,255,255,.03); }
.d-tbl tr:last-child td { border-bottom:none; }
.d-tbl-wrap { overflow:hidden;border-radius:8px;border:none var(--d-border); }
.d-empty { display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;color:var(--d-muted);gap:8px; }
.d-health-cell { background:#F7F8FD;border:none;border-radius:8px;padding:10px;margin:8px 0; display:flex;}
.d-health-lbl  { font-size:.71rem;color:var(--d-muted);margin-bottom:3px;display:flex;align-items:center;gap:6px; justify-content:start; width:150px;}
.d-health-val  { font-weight:600;color:var(--d-accent);font-size:.83rem; word-break:break-all; justify-content:end; display:flex; padding-right:10px; padding-left:10px; width:100%; }
.d-connected { color: var(--d-green); font-weight: 700; }
.d-disc      { color: var(--d-red); }
.d-alert { background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);border-radius:12px;padding:12px 16px;display:flex;align-items:flex-start;gap:10px; }
.d-alert p { color:#fcd34d;font-size:.83rem;margin:0; }
.chart-container { position:relative; width:100%; }
.chart-h280 { height:280px; }
.chart-h270 { height:270px; }
/* The legend stays physically to the right, including on RTL pages. */
.dashboard-round-layout {
    display:grid;
    grid-template-columns:minmax(0,3fr) minmax(0,2fr);
    grid-template-rows:minmax(0,1fr);
    align-items:center;
    gap:clamp(6px,2vw,18px);
    width:100%;
    height:280px;
    direction:ltr;
}
.dashboard-round-stage { position:relative; min-width:0; height:100%; }
.dashboard-round-stage canvas { width:100% !important; height:100% !important; }
.dashboard-round-scroll {
    display:grid;
    grid-template-rows:24px minmax(0,1fr) 24px;
    min-width:0;
    min-height:0;
    height:100%;
}
.dashboard-round-arrow {
    border:0;
    border-radius:4px;
    background:transparent;
    color:var(--isb-blue);
    font:inherit;
    line-height:1;
    cursor:pointer;
}
.dashboard-round-arrow:hover,
.dashboard-round-arrow:focus-visible { background:var(--isb-field); }
.dashboard-round-results {
    min-width:0;
    max-height:100%;
    overflow:auto;
    overscroll-behavior-y:contain;
    scrollbar-width:none;
}
.dashboard-round-results::-webkit-scrollbar { display:none; }
.dashboard-round-results[dir="rtl"] { direction:rtl; }
.dashboard-round-row {
    display:flex;
    align-items:center;
    gap:7px;
    width:100%;
    min-width:0;
    padding:6px 4px;
    border:0;
    border-bottom:1px solid var(--isb-border-soft);
    background:transparent;
    color:var(--isb-ink);
    font:inherit;
    font-size:.8rem;
    text-align:start;
    cursor:pointer;
}
.dashboard-round-row:hover { background:var(--isb-field); }
.dashboard-round-row:focus-visible { outline:2px solid var(--isb-blue); outline-offset:-2px; }
.dashboard-round-dot { width:11px; height:11px; flex:none; }
.dashboard-round-label { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.dashboard-round-row strong { font-variant-numeric:tabular-nums; }
#chartDocActivity { direction:ltr !important; }
@@media(max-width:900px){.d-grid-5{grid-template-columns:repeat(2,1fr)}.d-grid-2{grid-template-columns:1fr}}
@@media(max-width:500px){.d-grid-5{grid-template-columns:1fr}}

.table-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    padding: 16px 10px;
}
.pagination-button {
    min-width: 36px;
    height: 34px;
    padding: 0 11px;
    border: none;
    border-radius: 6px;
    background: #F7F8FD;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease,border-color 0.15s ease,color 0.15s ease;
}
.pagination-button:hover:not(:disabled):not(.active) { background: #89b6ff; color: #ffffff; }
.pagination-button.active { background: #3b82f6; border-color: #3b82f6; color: #ffffff; cursor: default; }
.pagination-button:disabled { opacity: 0.35; cursor: not-allowed; }
.pagination-jump { display:flex; align-items:center; gap:5px; margin-inline-start:6px; color:var(--d-muted); font-size:12px; white-space:nowrap; }
.pagination-jump input { width:50px; height:34px; padding:0 7px; border:1px solid #dbe2ef; border-radius:6px; background:#fff; color:var(--d-text); font:inherit; text-align:center; appearance:textfield; -moz-appearance:textfield; }
.pagination-jump input::-webkit-outer-spin-button,
.pagination-jump input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
.pagination-jump-total { font-variant-numeric:tabular-nums; }
.pagination-jump button { min-width:34px; padding:0 8px; }
.folder-kpi-card {
    background: linear-gradient(135deg, #0878e8, #0b40a2);
    border-radius: 18px;
    padding: 24px 26px;
    min-height: 175px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    color: white;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.18);
}
.folder-kpi-icon { color: white; display: flex; align-items: flex-start; justify-content: center; }
.folder-kpi-value { font-size: 40px; font-weight: 700; line-height: 1; }
.folder-kpi-label { font-size: 14px; font-weight: 400; color: rgba(255, 255, 255, 0.95); }
.template-percent-cell { width:40%; min-width:320px; }
.template-percent-chart { display:flex; align-items:center; gap:12px; width:100%; }
.template-percent-canvas { position:relative; flex:1 1 auto; min-width:0; height:28px; }
.template-percent-canvas canvas { width:100% !important; height:28px !important; }
.totalPercentText { min-width:48px; flex-shrink:0; font-size:11px; color:#64748B; font-variant-numeric:tabular-nums; white-space:nowrap; text-align:end; }
.dashboard-drilldown { text-decoration:none; cursor:pointer; }
.d-card.dashboard-drilldown { color:inherit; }
a.folder-kpi-card,
a.folder-kpi-card:visited,
a.folder-kpi-card:hover,
a.folder-kpi-card:focus,
a.folder-kpi-card:active {
    background:linear-gradient(135deg,#0878e8,#0b40a2);
    color:#fff;
    text-decoration:none;
}
a.folder-kpi-card .folder-kpi-icon,
a.folder-kpi-card .folder-kpi-value { color:#fff; }
a.folder-kpi-card .folder-kpi-label { color:rgba(255,255,255,.95); }
.dashboard-drilldown-row { cursor:pointer; }
.dashboard-drilldown-row:focus-visible { outline:2px solid var(--d-accent); outline-offset:-2px; }
@@media(max-width:700px){.template-percent-cell{min-width:220px}.totalPercentText{min-width:42px}.template-percent-chart{gap:8px}}
</style>
