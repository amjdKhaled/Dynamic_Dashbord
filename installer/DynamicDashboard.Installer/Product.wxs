<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Dynamic Dashboard"
           Manufacturer="ISB"
           Language="1033"
           Version="$(ProductVersion)"
           UpgradeCode="{1EA478E1-1A44-420D-AC04-D446B0B64E34}"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Dynamic Dashboard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="low" />
    <!-- File costing only; keep Windows restore points and rollback enabled. -->
    <Property Id="MSIFASTINSTALL" Value="2" />
    <Property Id="DYNAMIC_LF_SERVER" Secure="yes" />
    <Property Id="SAVED_DYNAMIC_LF_SERVER">
      <RegistrySearch Id="SavedDynamicServer" Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer"
                      Name="ServerUrl" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="DYNAMIC_LF_API_PATH" Secure="yes" />
    <Property Id="SAVED_DYNAMIC_LF_API_PATH">
      <RegistrySearch Id="SavedDynamicApiPath" Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer"
                      Name="ApiBasePath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="DYNAMIC_LF_API_VERSION" Secure="yes" />
    <Property Id="SAVED_DYNAMIC_LF_API_VERSION">
      <RegistrySearch Id="SavedDynamicApiVersion" Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer"
                      Name="ApiVersion" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="DYNAMIC_LF_SERVER" Value="[SAVED_DYNAMIC_LF_SERVER]" After="AppSearch" Sequence="both" Condition="NOT DYNAMIC_LF_SERVER AND SAVED_DYNAMIC_LF_SERVER" />
    <SetProperty Id="DYNAMIC_LF_API_PATH" Value="[SAVED_DYNAMIC_LF_API_PATH]" After="AppSearch" Sequence="both" Condition="NOT DYNAMIC_LF_API_PATH AND SAVED_DYNAMIC_LF_API_PATH" />
    <SetProperty Id="DYNAMIC_LF_API_VERSION" Value="[SAVED_DYNAMIC_LF_API_VERSION]" After="AppSearch" Sequence="both" Condition="NOT DYNAMIC_LF_API_VERSION AND SAVED_DYNAMIC_LF_API_VERSION" />
    <Property Id="DYNAMIC_WEB_PATH" Secure="yes" />
    <Property Id="DYNAMIC_WEB_URL" Secure="yes" />
    <Property Id="SAVED_DYNAMIC_WEB_PATH">
      <RegistrySearch Id="FindWebClientPath" Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer"
                      Name="WebClientPath" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="DYNAMIC_WEB_PATH" Value="[SAVED_DYNAMIC_WEB_PATH]" After="AppSearch" Sequence="both" Condition="NOT DYNAMIC_WEB_PATH AND SAVED_DYNAMIC_WEB_PATH" />
    <Property Id="SAVED_DYNAMIC_WEB_URL">
      <RegistrySearch Id="FindWebClientUrl" Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer"
                      Name="WebClientUrl" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="DYNAMIC_WEB_URL" Value="[SAVED_DYNAMIC_WEB_URL]" After="AppSearch" Sequence="both" Condition="NOT DYNAMIC_WEB_URL AND SAVED_DYNAMIC_WEB_URL" />
    <Launch Condition="NOT SAVED_DYNAMIC_WEB_PATH OR NOT DYNAMIC_WEB_PATH OR SAVED_DYNAMIC_WEB_PATH ~= DYNAMIC_WEB_PATH"
            Message="Uninstall the existing Dynamic Dashboard integration before selecting a different Web Access folder." />
    <Component Id="DynamicConnectionDefaults" Directory="DYNAMICINSTALLFOLDER"
               Guid="{D031A2FB-EFFD-44E2-AD82-D0E1073C36E9}" Bitness="always64">
      <RegistryKey Root="HKLM" Key="Software\ISB\DynamicDashboard\Installer">
        <RegistryValue Name="ServerUrl" Type="string" Value="[DYNAMIC_LF_SERVER]" KeyPath="yes" />
        <RegistryValue Name="ApiBasePath" Type="string" Value="[DYNAMIC_LF_API_PATH]" />
        <RegistryValue Name="ApiVersion" Type="string" Value="[DYNAMIC_LF_API_VERSION]" />
        <RegistryValue Name="WebClientPath" Type="string" Value="[DYNAMIC_WEB_PATH]" />
        <RegistryValue Name="WebClientUrl" Type="string" Value="[DYNAMIC_WEB_URL]" />
      </RegistryKey>
    </Component>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DYNAMICINSTALLFOLDER" Name="Dynamic Dashboard" />
    </StandardDirectory>
    <StandardDirectory Id="System64Folder" />
    <StandardDirectory Id="StartupFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DYNAMICMENUFOLDER" Name="Dynamic Dashboard" />
    </StandardDirectory>

    <Component Id="DynamicDashboardShortcut" Directory="DYNAMICMENUFOLDER"
               Guid="{932673B1-4C7B-4180-AC00-20A0FB7BF8D7}">
      <Shortcut Id="OpenDynamicDashboard" Name="Dynamic Dashboard"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments='-NoProfile -ExecutionPolicy Bypass -File "[DYNAMICINSTALLFOLDER]Start-Dashboard.ps1" -Published -InstalledDynamic -Port 5190'
                WorkingDirectory="DYNAMICINSTALLFOLDER" />
      <RemoveFolder Id="RemoveDynamicMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Dynamic Dashboard\Shortcuts"
                     Name="Open" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DynamicDashboardAutostart" Directory="StartupFolder"
               Guid="{E7960898-41DA-4F8B-848C-C93E1923B62F}">
      <Shortcut Id="StartDynamicDashboardAtSignIn" Name="Dynamic Dashboard Background"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments='-WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File "[DYNAMICINSTALLFOLDER]Start-Dashboard.ps1" -Published -InstalledDynamic -Port 5190 -NoBrowser'
                WorkingDirectory="DYNAMICINSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\ISB\DynamicDashboard" Name="Autostart"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>


    <CustomAction Id="StartDynamicDashboardAfterSetup" Directory="DYNAMICINSTALLFOLDER"
                  ExeCommand='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File "[DYNAMICINSTALLFOLDER]Start-Dashboard.ps1" -Published -InstalledDynamic -Port 5190 -NoBrowser'
                  Execute="immediate" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartDynamicDashboardAfterSetup"
               Order="1" Condition="NOT Installed AND NOT REMOVE" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BrandAssets)\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.BrandAssets)\Dialog.bmp" />
    <Binary Id="DynamicWizardSidebar" SourceFile="$(var.BrandAssets)\WizardSidebar.bmp" />
    <UIRef Id="WixUI_Common" />
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="11" Bold="yes" />
      <TextStyle Id="DynamicHeading" FaceName="Segoe UI" Size="17" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WaitForCostingDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <ComboBox Property="DYNAMIC_LF_API_VERSION">
        <ListItem Value="Auto" Text="Auto Detect (recommended)" />
        <ListItem Value="v2" Text="v2" />
        <ListItem Value="v1" Text="v1" />
      </ComboBox>
      <Dialog Id="DynamicWelcomeDlg" Width="540" Height="335" Title="Dynamic Dashboard Setup">
        <Control Id="Sidebar" Type="Bitmap" X="0" Y="0" Width="112" Height="335" Text="DynamicWizardSidebar" />
        <Control Id="Title" Type="Text" X="128" Y="16" Width="392" Height="28" Text="{\DynamicHeading}Welcome to Dynamic Dashboard" />
        <Control Id="Subtitle" Type="Text" X="128" Y="48" Width="392" Height="18" Text="Set up the independent dashboard for your Laserfiche repository." />
        <Control Id="License" Type="ScrollableText" X="128" Y="73" Width="392" Height="178" Sunken="yes">
          <Text SourceFile="$(var.BrandAssets)\License.rtf" />
        </Control>
        <Control Id="Consent" Type="Text" X="128" Y="257" Width="392" Height="22" Text="By selecting Continue, you accept the license terms." />
        <Control Id="FooterLine" Type="Line" X="112" Y="296" Width="428" Height="0" />
        <Control Id="Continue" Type="PushButton" X="388" Y="307" Width="60" Height="19" Default="yes" Text="&amp;Continue">
          <Publish Property="DYNAMIC_LF_SERVER" Value="https://localhost" Order="1" Condition="NOT DYNAMIC_LF_SERVER" />
          <Publish Property="DYNAMIC_LF_API_PATH" Value="/LFRepositoryAPI" Order="2" Condition="NOT DYNAMIC_LF_API_PATH" />
          <Publish Property="DYNAMIC_LF_API_VERSION" Value="Auto" Order="3" Condition="NOT DYNAMIC_LF_API_VERSION" />
          <Publish Event="NewDialog" Value="DynamicConnectionDlg" Order="4" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="460" Y="307" Width="60" Height="19" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="DynamicConnectionDlg" Width="540" Height="335" Title="Dynamic Dashboard Setup">
        <Control Id="Sidebar" Type="Bitmap" X="0" Y="0" Width="112" Height="335" Text="DynamicWizardSidebar" />
        <Control Id="Title" Type="Text" X="128" Y="16" Width="392" Height="28" Text="{\DynamicHeading}Connect to Laserfiche" />
        <Control Id="Subtitle" Type="Text" X="128" Y="48" Width="392" Height="18" Text="Enter the connection information used by Dynamic Dashboard." />
        <Control Id="ServerLabel" Type="Text" X="128" Y="81" Width="392" Height="14" Text="Laserfiche server URL" />
        <Control Id="Server" Type="Edit" X="128" Y="98" Width="392" Height="19" Property="DYNAMIC_LF_SERVER" />
        <Control Id="ServerHint" Type="Text" X="128" Y="121" Width="392" Height="18" Text="Default: https://localhost. A full API URL is also accepted." />
        <Control Id="ApiLabel" Type="Text" X="128" Y="150" Width="190" Height="14" Text="API base path" />
        <Control Id="ApiPath" Type="Edit" X="128" Y="167" Width="190" Height="19" Property="DYNAMIC_LF_API_PATH" />
        <Control Id="VersionLabel" Type="Text" X="330" Y="150" Width="190" Height="14" Text="API version" />
        <Control Id="Version" Type="ComboBox" X="330" Y="167" Width="190" Height="19" Property="DYNAMIC_LF_API_VERSION" ComboList="yes" />
        <Control Id="VersionHint" Type="Text" X="330" Y="190" Width="190" Height="28" Text="Auto Detect tries v2 and then v1." />
        <Control Id="FooterLine" Type="Line" X="112" Y="296" Width="428" Height="0" />
        <Control Id="Back" Type="PushButton" X="316" Y="307" Width="60" Height="19" Text="&amp;Back">
          <Publish Event="NewDialog" Value="DynamicWelcomeDlg" Condition="1" />
        </Control>
        <Control Id="Continue" Type="PushButton" X="388" Y="307" Width="60" Height="19" Default="yes" Text="&amp;Continue">
          <Publish Event="NewDialog" Value="DynamicDeploymentDlg" Order="4" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="460" Y="307" Width="60" Height="19" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="DynamicDeploymentDlg" Width="540" Height="335" Title="Dynamic Dashboard Setup">
        <Control Id="Sidebar" Type="Bitmap" X="0" Y="0" Width="112" Height="335" Text="DynamicWizardSidebar" />
        <Control Id="Title" Type="Text" X="128" Y="16" Width="392" Height="28" Text="{\DynamicHeading}Choose deployment options" />
        <Control Id="Subtitle" Type="Text" X="128" Y="48" Width="392" Height="18" Text="Confirm how users will open the dashboard." />
        <Control Id="HostLabel" Type="Text" X="128" Y="80" Width="392" Height="20" Text="{\WixUI_Font_Title}Dashboard website" />
        <Control Id="HostInfo" Type="Text" X="128" Y="103" Width="392" Height="30" Text="The installed dashboard starts automatically and listens on http://127.0.0.1:5190 on this computer." />
        <Control Id="IntegrationLabel" Type="Text" X="128" Y="144" Width="392" Height="20" Text="{\WixUI_Font_Title}Laserfiche Web Access integration (optional)" />
        <Control Id="WebPathLabel" Type="Text" X="128" Y="171" Width="392" Height="14" Text="Web Access folder containing Browse.aspx" />
        <Control Id="WebPath" Type="Edit" X="128" Y="188" Width="392" Height="19" Property="DYNAMIC_WEB_PATH" />
        <Control Id="WebUrlLabel" Type="Text" X="128" Y="217" Width="392" Height="14" Text="Dashboard URL for the Web Access toolbar button" />
        <Control Id="WebUrl" Type="Edit" X="128" Y="234" Width="392" Height="19" Property="DYNAMIC_WEB_URL" />
        <Control Id="WebHint" Type="Text" X="128" Y="258" Width="392" Height="28" Text="Leave the folder blank to skip the toolbar button on a fresh install." />
        <Control Id="FooterLine" Type="Line" X="112" Y="296" Width="428" Height="0" />
        <Control Id="Back" Type="PushButton" X="316" Y="307" Width="60" Height="19" Text="&amp;Back">
          <Publish Event="NewDialog" Value="DynamicConnectionDlg" Condition="1" />
        </Control>
        <Control Id="Continue" Type="PushButton" X="388" Y="307" Width="60" Height="19" Default="yes" Text="&amp;Continue">
          <Publish Event="NewDialog" Value="DynamicReviewDlg" Order="4" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="460" Y="307" Width="60" Height="19" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Dialog Id="DynamicReviewDlg" Width="540" Height="335" Title="Dynamic Dashboard Setup">
        <Control Id="Sidebar" Type="Bitmap" X="0" Y="0" Width="112" Height="335" Text="DynamicWizardSidebar" />
        <Control Id="Title" Type="Text" X="128" Y="16" Width="392" Height="28" Text="{\DynamicHeading}Ready to install" />
        <Control Id="Subtitle" Type="Text" X="128" Y="48" Width="392" Height="18" Text="Review your settings, then select Install." />
        <Control Id="Settings" Type="Text" X="128" Y="84" Width="392" Height="60" Text="Laserfiche server: [DYNAMIC_LF_SERVER]&#13;&#10;API path: [DYNAMIC_LF_API_PATH]&#13;&#10;API version: [DYNAMIC_LF_API_VERSION]" />
        <Control Id="Folder" Type="Text" X="128" Y="150" Width="392" Height="44" Text="Install location: [DYNAMICINSTALLFOLDER]" />
        <Control Id="FooterLine" Type="Line" X="112" Y="296" Width="428" Height="0" />
        <Control Id="Back" Type="PushButton" X="316" Y="307" Width="60" Height="19" Text="&amp;Back">
          <Publish Event="NewDialog" Value="DynamicDeploymentDlg" Condition="1" />
        </Control>
        <Control Id="Continue" Type="PushButton" X="388" Y="307" Width="60" Height="19" Default="yes" Text="&amp;Install">
          <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="1" Condition="CostingComplete &lt;&gt; 1" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="2" Condition="OutOfDiskSpace = 1" />
          <Publish Event="EndDialog" Value="Return" Order="3" Condition="CostingComplete = 1 AND OutOfDiskSpace &lt;&gt; 1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="460" Y="307" Width="60" Height="19" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="DynamicWelcomeDlg" Before="ProgressDlg" Condition="NOT Installed" />
    </InstallUISequence>

    <SetProperty Id="DYNAMIC_WEB_URL" Value="http://127.0.0.1:5190" Before="InstallInitialize" Sequence="execute" Action="SetDynamicDefaultWebUrl" Condition="DYNAMIC_WEB_PATH AND NOT DYNAMIC_WEB_URL" />
    <CustomAction Id="StopOwnedDynamicDashboard" BinaryRef="DynamicSetupHelper"
                  ExeCommand="--stop-dynamic-dashboard --variant dynamic"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="StopOwnedDynamicDashboard" Before="RemoveFiles" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="RollbackDynamicButtonInstall" After="InstallFiles" Condition="NOT Installed AND DYNAMIC_WEB_PATH" />
      <Custom Action="CommitDynamicButtonInstall" After="RollbackDynamicButtonInstall" Condition="NOT Installed AND DYNAMIC_WEB_PATH" />
      <Custom Action="DeployDynamicButton" After="CommitDynamicButtonInstall" Condition="NOT Installed AND DYNAMIC_WEB_PATH" />
      <Custom Action="RollbackDynamicButtonRemoval" Before="RemoveDynamicButton" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DYNAMIC_WEB_PATH" />
      <Custom Action="RemoveDynamicButton" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DYNAMIC_WEB_PATH" />
      <Custom Action="CommitDynamicButtonRemoval" Before="RollbackDynamicButtonRemoval" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DYNAMIC_WEB_PATH" />
    </InstallExecuteSequence>
    <Binary Id="DynamicSetupHelper" SourceFile="$(var.DynamicSetupHelper)" />
    <CustomAction Id="RollbackDynamicButtonInstall" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--rollback-webclient --variant dynamic --transaction "[ProductCode]" --path "[DYNAMIC_WEB_PATH]\."'
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="CommitDynamicButtonInstall" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--commit-webclient --variant dynamic --transaction "[ProductCode]"'
                  Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="DeployDynamicButton" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--deploy-webclient --variant dynamic --transaction "[ProductCode]" --previous-path "[SAVED_DYNAMIC_WEB_PATH]\." --path "[DYNAMIC_WEB_PATH]\." --url "[DYNAMIC_WEB_URL]" --source-js "[DYNAMICINSTALLFOLDER]wwwroot\js\lf-dynamic-dashboard-button.js"'
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackDynamicButtonRemoval" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--rollback-webclient --variant dynamic --transaction "[ProductCode]" --path "[DYNAMIC_WEB_PATH]\."'
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="CommitDynamicButtonRemoval" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--commit-webclient --variant dynamic --transaction "[ProductCode]"'
                  Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoveDynamicButton" BinaryRef="DynamicSetupHelper"
                  ExeCommand='--remove-webclient --variant dynamic --transaction "[ProductCode]" --path "[DYNAMIC_WEB_PATH]\." --url "[DYNAMIC_WEB_URL]" --source-js "[DYNAMICINSTALLFOLDER]wwwroot\js\lf-dynamic-dashboard-button.js"'
                  Execute="deferred" Impersonate="no" Return="check" />
    <Feature Id="DynamicDashboardFeature" Title="Dynamic Dashboard" Level="1">
      <ComponentGroupRef Id="DynamicFiles" />
      <ComponentRef Id="DynamicDashboardShortcut" />
      <ComponentRef Id="DynamicDashboardAutostart" />
      <ComponentRef Id="DynamicConnectionDefaults" />
    </Feature>
  </Package>
</Wix>
